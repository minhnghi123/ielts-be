# Must match JWT_SECRET of auth-service — the gateway verifies tokens itself
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Shared secret the gateway attaches to every forwarded request (x-internal-key).
# Downstream services reject requests without it, so they cannot be called directly.
INTERNAL_API_KEY=change-me-internal-key

AUTH_SERVICE_URL=http://localhost:5001
TEST_SERVICE_URL=http://localhost:5002
SUBMISSION_SERVICE_URL=http://localhost:5003
ANALYTICS_SERVICE_URL=http://localhost:5004

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
